<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.search.SearchMapper">

    <!-- 検索 -->
    <select id="search"
            resultType="com.example.demo.entity.Product">

        SELECT *
        FROM products

        <where>

            <!-- キーワード検索 -->
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>

            <!-- エリア -->
            <if test="areas != null and areas.size() > 0">

                AND area_id IN

                <foreach collection="areas"
                         item="area"
                         open="("
                         separator=","
                         close=")">

                    #{area}

                </foreach>

            </if>

            <!-- カテゴリー -->
            <if test="categories != null and categories.size() > 0">

                AND category_id IN

                <foreach collection="categories"
                         item="category"
                         open="("
                         separator=","
                         close=")">

                    #{category}

                </foreach>

            </if>

            <!-- 最低価格 -->
            <if test="minPrice != null">
                AND price &gt;= #{minPrice}
            </if>

            <!-- 最高価格 -->
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>

        </where>

        <!-- 並び替え -->
        <choose>

            <when test="sort eq 'popular'">
                ORDER BY favorite_count DESC
            </when>

            <when test="sort eq 'priceAsc'">
                ORDER BY price ASC
            </when>

            <when test="sort eq 'priceDesc'">
                ORDER BY price DESC
            </when>

            <when test="sort eq 'newest'">
                ORDER BY updated_at DESC
            </when>

            <otherwise>
                ORDER BY id DESC
            </otherwise>

        </choose>

    </select>

    <!-- 人気ランキング TOP5 -->
    <select id="findTop5Popular"
            resultType="com.example.demo.entity.Product">

        SELECT *
        FROM products
        ORDER BY favorite_count DESC
        LIMIT 5

    </select>

</mapper>